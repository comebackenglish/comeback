    <script>
        (function () {
            try { localStorage.removeItem('comeback_theme_preference'); } catch (e) { }
            function getBangladeshTheme() {
                var hour;
                try {
                    var str = new Intl.DateTimeFormat('en-US', {
                        timeZone: 'Asia/Dhaka',
                        hour: 'numeric',
                        hour12: false
                    }).format(new Date());
                    var parsed = parseInt(str, 10);
                    if (!isNaN(parsed)) hour = parsed % 24;
                } catch (e) { }
                if (hour === undefined) {
                    hour = (new Date().getUTCHours() + 6) % 24;
                }
                return (hour >= 6 && hour < 18) ? 'light' : 'dark';
            }
            document.documentElement.setAttribute('data-theme', getBangladeshTheme());
        })();
    </script>
